  "Features": {
    "ConditionalReferencePseudonymization": false
  },
  "Anonymization": {
    "CryptoHashKey": "",
    "EncryptKey": "",
    "ShouldAddSecurityTag": true
  },
  "Kafka": {
    "Enabled": false,
    "Topics": [],
    "OutputTopicPattern": "^",
    "OutputTopicReplacement": "pseudonymized.",
    "WorkerChannelCapacity": 10000,
    "WorkerChannelCapacityBytes": 16777216,
    "Client": {
      "BootstrapServers": "",
      "SecurityProtocol": "PLAINTEXT"
