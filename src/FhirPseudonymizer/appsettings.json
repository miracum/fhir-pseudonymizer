      "OAuth": {
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "",
        "Resource": ""
      }
    }
  },
  "Vfps": {
    "Address": "",
    "UnsafeUseInsecureChannelCallCredentials": true,
    "UseTls": false,
    "Retry": {
      "Count": 3
    },
    "Auth": {
      "AccessToken": "",
      "Basic": {
        "Username": "",
        "Password": ""
      },
      "OAuth": {
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "",
        "Resource": ""
      }
    }
  },
  "entici": {
    "Url": "",
    "Retry": {
      "Count": 3
    },
    "Auth": {
      "Basic": {
        "Username": "",
        "Password": ""
      },
      "OAuth": {
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "",
        "Resource": ""
      }
    }
  },
  "Mii": {
    "Url": "",
    "Retry": {
      "Count": 3
    },
    "Auth": {
      "Basic": {
        "Username": "",
        "Password": ""
      },
      "OAuth": {
        "TokenEndpoint": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "",
        "Resource": ""
      }
    }
